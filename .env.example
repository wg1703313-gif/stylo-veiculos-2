# Copie para .env.local e preencha com as credenciais do seu projeto Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon
# SUPABASE_URL e SUPABASE_ANON_KEY também são aceitos como nomes alternativos.
# WhatsApp em formato internacional, somente números (ex.: 5596984186541)
NEXT_PUBLIC_WHATSAPP_NUMBER=5596984186541
# Contatos da loja: atualize também os placeholders no arquivo lib/store.ts
